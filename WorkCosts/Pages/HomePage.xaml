<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkCosts.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition x:Name="CarouselRow" Height="0" />
        </Grid.RowDefinitions>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Work Jobs" />
                    <TextBlock Opacity="0.7" Text="Plan DIY jobs and track savings versus garage prices." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Click="Add_Click"
                    Style="{ThemeResource AppAccentButtonStyle}"
                    ToolTipService.ToolTip="New Work Job">
                    <FontIcon Glyph="&#xE710;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <GridView
                    x:Name="WorkJobGrid"
                    IsItemClickEnabled="True"
                    ItemClick="WorkJobGrid_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="280"
                                MinHeight="140"
                                Margin="0,0,16,16"
                                Padding="16"
                                Style="{ThemeResource AppPanelStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Title}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock Opacity="0.7" Text="{Binding JobName}" />
                                        <TextBlock Opacity="0.7" Text="{Binding Meta}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding SavingText}" />
                                        <Button
                                            Grid.Column="1"
                                            Click="Delete_Click"
                                            Content="Delete"
                                            Tag="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="No Work Jobs yet. Tap + to plan a DIY job."
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid
            x:Name="CarouselHost"
            Grid.Row="1"
            SizeChanged="CarouselHost_SizeChanged"
            Visibility="Collapsed">
            <StackPanel
                x:Name="CarouselStrip"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Orientation="Horizontal">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CarouselTranslate" />
                </StackPanel.RenderTransform>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
