<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkCosts.Pages.MasterDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkCosts.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WorkCosts.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Master: job list -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="Jobs" />
                    <TextBlock Opacity="0.7" Text="Select a job to edit details." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="Add_Click"
                    Content="Add"
                    Style="{ThemeResource AppAccentButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="JobsList"
                    IsItemClickEnabled="False"
                    SelectionChanged="JobsList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Style="{ThemeResource AppTextBlockStyle}" Text="{Binding Name}" />
                                <TextBlock Opacity="0.7" Style="{ThemeResource AppTextBlockStyle}" Text="{Binding Summary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="EmptyListText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="No jobs yet."
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Detail -->
        <Border
            Grid.Column="1"
            Style="{ThemeResource AppPanelStyle}"
            Padding="20">
            <Grid>
                <Grid x:Name="DetailPanel" RowSpacing="16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DetailTitle"
                            FontWeight="SemiBold"
                            Text="Job details"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Click="Delete_Click"
                            Style="{ThemeResource BorderlessIconButtonStyle}"
                            ToolTipService.ToolTip="Delete job">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NameBox"
                            Header="Name"
                            PlaceholderText="Job name"
                            TextChanged="NameBox_TextChanged" />
                        <NumberBox
                            x:Name="PriceBox"
                            Grid.Column="1"
                            Header="Garage price"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="PriceBox_ValueChanged" />
                        <TextBox
                            x:Name="DurationBox"
                            Grid.Column="2"
                            Header="Duration (hh:mm)"
                            PlaceholderText="1:00"
                            TextChanged="DurationBox_TextChanged"
                            LostFocus="DurationBox_LostFocus" />
                    </Grid>

                    <Pivot Grid.Row="2" MinHeight="240">
                            <PivotItem Header="Notes">
                                <controls:MarkdownEditor x:Name="NotesEditor" />
                            </PivotItem>
                            <PivotItem Header="Products">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{ThemeResource AppTextBlockStyle}"
                                        Text="Check products assigned to this job."
                                        TextWrapping="WrapWholeWords" />
                                    <ListView
                                        x:Name="JobProductsList"
                                        Grid.Row="1"
                                        IsItemClickEnabled="False"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:JobProductRow">
                                                <Grid Padding="0,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        Checked="JobProductAssignment_Changed"
                                                        IsChecked="{x:Bind IsAssigned, Mode=TwoWay}"
                                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                        Unchecked="JobProductAssignment_Changed"
                                                        VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Style="{ThemeResource AppTextBlockStyle}"
                                                            Text="{x:Bind Name, Mode=OneWay}" />
                                                        <TextBlock
                                                            Opacity="0.7"
                                                            Style="{ThemeResource AppTextBlockStyle}"
                                                            Text="{x:Bind Detail, Mode=OneWay}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </PivotItem>
                        </Pivot>

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            x:Name="SaveButton"
                            Click="Save_Click"
                            Content="Save"
                            IsEnabled="False"
                            Style="{ThemeResource AppAccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="NoSelectionText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="Select a job from the list, or add a new one." />
            </Grid>
        </Border>
    </Grid>
</Page>
