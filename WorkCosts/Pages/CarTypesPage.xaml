<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkCosts.Pages.CarTypesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    PreviewKeyDown="Page_PreviewKeyDown"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TypeCardTemplate">
            <StackPanel Padding="0,8" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                <TextBlock Opacity="0.7" Text="{Binding Detail}" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="2*" MinWidth="260" />
            <ColumnDefinition x:Name="DetailColumn" Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Header" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Car types" />
                <TextBlock Opacity="0.7" Text="Catalogue types. Not a vehicle you own." TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="PageAddButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="Add_Click"
                Content="Add"
                Style="{ThemeResource AppAccentButtonStyle}" />
        </Grid>

        <Grid x:Name="ListPane" Grid.Row="1">
            <ListView
                x:Name="TypesList"
                ItemTemplate="{StaticResource TypeCardTemplate}"
                SelectionChanged="TypesList_SelectionChanged"
                SelectionMode="Single" />
            <TextBlock
                x:Name="EmptyListText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6"
                Text="No car types yet."
                Visibility="Collapsed" />
        </Grid>

        <Border
            x:Name="DetailPane"
            Grid.Row="1"
            Grid.Column="1"
            Padding="20"
            Style="{ThemeResource AppPanelStyle}">
            <Grid>
                <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="DetailBackButton"
                                VerticalAlignment="Center"
                                Click="DetailBack_Click"
                                Content="Back"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="DetailTitle"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Car type" />
                            <Button
                                Grid.Column="2"
                                Click="Delete_Click"
                                Style="{ThemeResource BorderlessIconButtonStyle}"
                                ToolTipService.ToolTip="Delete car type">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="DetailMakeBox" Header="Make" MaxLength="120" PlaceholderText="BMW" TextChanged="DetailField_Changed" />
                            <TextBox x:Name="DetailModelBox" Grid.Column="1" Header="Model" MaxLength="120" PlaceholderText="545" TextChanged="DetailField_Changed" />
                            <TextBox x:Name="DetailModelNumberBox" Grid.Column="2" Header="Model number" MaxLength="32" PlaceholderText="E60" TextChanged="DetailField_Changed" />
                            <TextBox x:Name="DetailYearBox" Grid.Row="1" Header="Model year" MaxLength="4" PlaceholderText="2004" TextChanged="DetailField_Changed" />
                            <TextBox x:Name="DetailEngineBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Engine type" MaxLength="200" PlaceholderText="4.4 V8" TextChanged="DetailField_Changed" />
                        </Grid>
                        <TextBlock
                            x:Name="DetailStatus"
                            Opacity="0.85"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="DetailSaveButton"
                            Click="DetailSave_Click"
                            Content="Save"
                            IsEnabled="False"
                            Style="{ThemeResource AppAccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock
                    x:Name="NoSelectionText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="Select a car type" />
            </Grid>
        </Border>

        <Border
            x:Name="AddOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Padding="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Style="{ThemeResource AppPanelStyle}"
            Visibility="Collapsed">
            <ScrollViewer>
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Add car type" />
                    <TextBox x:Name="AddMakeBox" Header="Make" MaxLength="120" PlaceholderText="BMW" TextChanged="AddField_Changed" />
                    <TextBox x:Name="AddModelBox" Header="Model" MaxLength="120" PlaceholderText="545" TextChanged="AddField_Changed" />
                    <TextBox x:Name="AddModelNumberBox" Header="Model number" MaxLength="32" PlaceholderText="E60" TextChanged="AddField_Changed" />
                    <TextBox x:Name="AddYearBox" Header="Model year" MaxLength="4" PlaceholderText="2004" TextChanged="AddField_Changed" />
                    <TextBox x:Name="AddEngineBox" Header="Engine type" MaxLength="200" PlaceholderText="4.4 V8" TextChanged="AddField_Changed" />
                    <TextBlock
                        x:Name="AddStatus"
                        Opacity="0.85"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="AddSaveButton"
                            Click="AddSave_Click"
                            Content="Save"
                            IsEnabled="False"
                            Style="{ThemeResource AppAccentButtonStyle}" />
                        <Button Click="AddCancel_Click" Content="Cancel" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
