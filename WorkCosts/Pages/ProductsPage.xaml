<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkCosts.Pages.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WorkCosts.Controls"
    xmlns:local="using:WorkCosts.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    PreviewKeyDown="Page_PreviewKeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ProductCardTemplate">
            <Grid Padding="0,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <TextBlock
                            Opacity="0.7"
                            Text="{Binding Detail}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
                <Border
                    Margin="2"
                    Padding="4,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="{Binding GeneralBadgeVisible}">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="G" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Top filter strip (auto height, never clipped) · Bottom 70% list + details -->
    <Grid x:Name="MasterDetailHost" Padding="24,24,24,24" ColumnSpacing="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="7*" MinHeight="240" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.05*" MinWidth="260" />
            <ColumnDefinition Width="5.95*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Products" />
                    <TextBlock
                        Opacity="0.7"
                        Text="Tools, parts, consumables and garage supplies."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    x:Name="PageAddButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="Add_Click"
                    Content="Add"
                    Style="{ThemeResource AppAccentButtonStyle}" />
            </Grid>
            <Border Grid.Row="1" Style="{ThemeResource AppPanelStyle}" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="RefreshFilters_Click"
                            Padding="4"
                            MinWidth="32"
                            Width="32"
                            Height="32"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Refresh lists and assignment panel">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{ThemeResource AppTextBlockStyle}"
                            Text="Jobs"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind JobFilters, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:JobFilterPillItem">
                                <Border
                                    Padding="12,6"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    PointerPressed="JobPill_PointerPressed"
                                    Tag="{x:Bind}">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8" VerticalAlignment="Top">
            <Border Style="{ThemeResource AppPanelStyle}" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Style="{ThemeResource AppTextBlockStyle}" Text="Categories" />
                    <ItemsControl ItemsSource="{x:Bind CategoryFilters, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CategoryFilterItem">
                                <Border
                                    Padding="12,6"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    PointerPressed="CategoryPill_PointerPressed"
                                    Tag="{x:Bind}">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{ThemeResource AppPanelStyle}" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{ThemeResource AppTextBlockStyle}"
                        Text="Price point" />
                    <ItemsControl ItemsSource="{x:Bind PricePointFilters, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PricePointFilterItem">
                                <Border
                                    Padding="12,6"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    PointerPressed="PricePointPill_PointerPressed"
                                    Tag="{x:Bind}">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{ThemeResource AppPanelStyle}"
            Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="FilterGroupHeader"
                            Margin="0,8,0,4"
                            FontWeight="SemiBold"
                            Style="{ThemeResource AppTextBlockStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="NoDirectJobProductsText"
                            Margin="0,0,0,8"
                            Opacity="0.7"
                            Style="{ThemeResource AppTextBlockStyle}"
                            Text="No products are assigned directly to this job."
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <ListView
                            x:Name="FilterProductList"
                            ItemTemplate="{StaticResource ProductCardTemplate}"
                            SelectionChanged="ProductList_SelectionChanged"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        <TextBlock
                            x:Name="AllGroupHeader"
                            Margin="0,12,0,4"
                            FontWeight="SemiBold"
                            Style="{ThemeResource AppTextBlockStyle}"
                            Text="General"
                            Visibility="Collapsed" />
                        <ListView
                            x:Name="AllProductList"
                            ItemTemplate="{StaticResource ProductCardTemplate}"
                            SelectionChanged="ProductList_SelectionChanged"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="No products match this filter."
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Style="{ThemeResource AppDetailPanelStyle}">
            <Grid>
                <Grid x:Name="DetailPanel" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            x:Name="DetailTitle"
                            Margin="0,0,40,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Product details" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="5"
                            Click="Delete_Click"
                            Style="{ThemeResource BorderlessIconButtonStyle}"
                            ToolTipService.ToolTip="Delete product">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                    <controls:ProductEditor
                        x:Name="DetailEditor"
                        Grid.Row="1"
                        VerticalAlignment="Stretch"
                        Margin="0,0,0,4" />
                </Grid>

                <Grid x:Name="AssignmentPanel" RowSpacing="8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="AssignmentTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                    <Grid Grid.Row="1">
                        <TextBox
                            x:Name="AssignmentFilterBox"
                            MaxLength="20"
                            PlaceholderText="Filter..."
                            Padding="12,8,36,8"
                            TextChanged="AssignmentFilterBox_TextChanged" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            Padding="4"
                            Click="AssignmentFilterClear_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Clear filter">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind AssignmentProducts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AssignableProductRow">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Top"
                                            Checked="AssignProduct_Changed"
                                            IsThreeState="False" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Opacity="0.7" Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <TextBlock
                    x:Name="NoSelectionText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="Select a product from the list, or add a new one." />
            </Grid>
        </Border>

        <!-- Sliding Add product overlay (opaque light green) -->
        <Border
            x:Name="AddOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Style="{ThemeResource AppPanelStyle}"
            Padding="20"
            Visibility="Collapsed"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AddOverlayTransform" X="40" />
            </Border.RenderTransform>

            <Grid>
            <!-- Stage 1: URL only -->
            <StackPanel
                x:Name="AddUrlStage"
                Spacing="8"
                MaxWidth="720"
                HorizontalAlignment="Stretch">
                <TextBox
                    x:Name="AddUrlBox"
                    PlaceholderText="https://product-page-url..."
                    KeyDown="AddUrlBox_KeyDown" />
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button
                        Click="AddUrlContinue_Click"
                        Content="Add"
                        Style="{ThemeResource AppAccentButtonStyle}" />
                    <Button
                        Click="PasteHtml_Click"
                        Content="Paste HTML" />
                    <Button
                        Click="OpenHtmlFile_Click"
                        Content="Open HTML file" />
                    <Button
                        Click="AddCancel_Click"
                        Content="Cancel" />
                </controls:WrapPanel>
                <TextBlock
                    x:Name="AddUrlError"
                    Opacity="0.9"
                    FontWeight="SemiBold"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Stage 2: split details form -->
            <Grid
                x:Name="AddDetailsStage"
                RowSpacing="12"
                Visibility="Collapsed"
                MinHeight="420">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="AddDetailsTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Add product" />
                    <TextBlock
                        x:Name="AddLoadStatus"
                        Opacity="0.7"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="AddExistingBanner"
                        Padding="12"
                        Visibility="Collapsed"
                        Style="{ThemeResource AppPanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="AddExistingMessage"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="AddExistingOverwrite_Click"
                                    Content="Overwrite"
                                    Style="{ThemeResource AppAccentButtonStyle}" />
                                <Button
                                    Click="AddExistingKeep_Click"
                                    Content="Keep existing" />
                                <Button
                                    Click="AddExistingCancel_Click"
                                    Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <controls:ProductAddEditor
                    x:Name="AddEditor"
                    Grid.Row="1"
                    VerticalAlignment="Stretch" />
                <Grid Grid.Row="2">
                    <Button
                        x:Name="AddDetailsCancelButton"
                        HorizontalAlignment="Left"
                        Click="AddDetailsCancel_Click"
                        Content="Cancel" />
                    <StackPanel
                        x:Name="AddSaveButtons"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="AddSaveButton"
                            Click="AddSave_Click"
                            Content="Add"
                            Style="{ThemeResource AppAccentButtonStyle}" />
                        <Button
                            x:Name="AddSaveAndCloseButton"
                            Click="AddSaveAndClose_Click"
                            Content="Add and Close"
                            Style="{ThemeResource AppAccentButtonStyle}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="AddViewButtons"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button
                            x:Name="AddViewSaveButton"
                            Click="AddViewSave_Click"
                            Content="Save"
                            Style="{ThemeResource AppAccentButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="AddViewCloseButton"
                            Click="AddViewClose_Click"
                            Content="Close" />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
