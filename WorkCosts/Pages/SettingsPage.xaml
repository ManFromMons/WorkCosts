<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorkCosts.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:WorkCosts.Pages"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="640" Spacing="16">
            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Settings" />
            <TextBlock Opacity="0.7" Text="Local unpackaged app data is stored in your user profile." />

            <Border Style="{ThemeResource AppSettingsPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Theme" />
                    <TextBlock Opacity="0.7" Text="Choose how WorkCosts follows light and dark appearance." />
                    <RadioButtons
                        x:Name="ThemeRadios"
                        Header="Appearance"
                        MaxColumns="3"
                        SelectionChanged="ThemeRadios_SelectionChanged">
                        <RadioButton Content="Auto" Tag="Auto" />
                        <RadioButton Content="Light" Tag="Light" />
                        <RadioButton Content="Dark" Tag="Dark" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource AppSettingsPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Database" />
                    <TextBlock x:Name="DbPathText" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource AppSettingsPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Page cache" />
                    <TextBlock
                        Opacity="0.7"
                        Text="Imported product pages and the photos shown in the image chooser are stored locally by site, so a second visit does not need to download them again. Clearing this cache does not remove products or photos already saved in the library."
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="PageCachePathText"
                        IsTextSelectionEnabled="True"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="PageCacheStatsText" Opacity="0.7" />

                    <ItemsControl x:Name="DomainCacheList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:DomainCacheRow">
                                <Grid Margin="0,4,0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        VerticalAlignment="Top"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <TextBlock Opacity="0.7" Text="{x:Bind PagesText}" />
                                        <TextBlock Opacity="0.7" Text="{x:Bind ImagesText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="DomainCacheEmptyText"
                        Opacity="0.7"
                        Text="No cached sites yet."
                        Visibility="Collapsed" />

                    <ToggleSwitch
                        x:Name="ClearImagesToggle"
                        HorizontalAlignment="Left"
                        Header="Also delete cached images"
                        IsOn="False"
                        OffContent="Keep images"
                        OnContent="Delete images" />
                    <TextBlock
                        Opacity="0.7"
                        Text="Off deletes only HTML pages. Chooser photos stay on disk so Autodoc and other sites are not hit again just for images. On deletes those photos as well."
                        TextWrapping="WrapWholeWords" />

                    <Button
                        HorizontalAlignment="Left"
                        Click="ClearPageCache_Click"
                        Content="Clear page cache" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource AppSettingsPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="About" />
                    <TextBlock Text="WorkCosts — DIY job cost planner for WinUI 3." />
                    <TextBlock Opacity="0.7" Text="Unpackaged · SQLite · NavigationView" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
