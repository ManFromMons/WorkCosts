<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WorkCosts.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:WorkCosts.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Styles/Light.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Styles/Light.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Styles/Dark.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <helpers:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <helpers:DurationFormatConverter x:Key="DurationFormat" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <helpers:PromptValueConverter x:Key="PromptValue" />

            <x:Double x:Key="AppContentFontSize">18</x:Double>
            <x:Double x:Key="AppInputFontSize">16</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
