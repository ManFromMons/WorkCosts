<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WorkCosts.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Will I DIY?"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Will I DIY?"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <ToggleSwitch
                    x:Name="TitleBarThemeSwitch"
                    MinWidth="0"
                    Margin="0,0,8,0"
                    OffContent="Light"
                    OnContent="Dark"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Toggled="TitleBarThemeSwitch_Toggled"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="{ThemeResource AppPanelFillBrush}"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" FontSize="18" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Work" FontSize="18" Tag="work">
                    <NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="&#xE821;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Stuff"
                    FontSize="18"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Products" FontSize="18" Tag="products">
                            <NavigationViewItem.Icon>
                                <ImageIcon Source="Assets/icon.jog.png" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Jobs" FontSize="18" Tag="jobs">
                            <NavigationViewItem.Icon>
                                <FontIcon FontSize="18" Glyph="&#xEA37;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Categories" FontSize="18" Tag="categories">
                            <NavigationViewItem.Icon>
                                <FontIcon FontSize="18" Glyph="&#xE8FD;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Image
                    Source="Assets/GarageBackground.png"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
                <Border Background="{ThemeResource AppPageBackgroundBrush}" Opacity="0.95" />
                <Frame x:Name="NavFrame" Background="Transparent" Navigated="NavFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
