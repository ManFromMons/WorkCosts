<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppPanelFillBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="AppPanelStrokeBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="AppChromeSelectedBrush" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#FFB4B4B4" />

    <!-- Panel Styles -->
    <Style x:Key="AppPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppPanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AppDetailPanelStyle" TargetType="Border" BasedOn="{StaticResource AppPanelStyle}">
        <Setter Property="Padding" Value="20,20,20,16" />
    </Style>

    <Style x:Key="AppSettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource AppPanelStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- TextBlock Styles -->
    <Style x:Key="AppTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Input Control Styles -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <!-- Button Styles -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style x:Key="AppAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style x:Key="BorderlessIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarLabelButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
