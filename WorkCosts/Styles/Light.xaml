<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppPanelFillBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="AppPanelStrokeBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="AppChromeSelectedBrush" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF000000" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#FFEFEFEF" />

    <!-- Panel Styles -->
    <Style x:Key="AppPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppPanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppPanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AppDetailPanelStyle" TargetType="Border" BasedOn="{StaticResource AppPanelStyle}">
        <Setter Property="Padding" Value="20,20,20,16" />
    </Style>

    <Style x:Key="AppSettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource AppPanelStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- TextBlock Styles -->
    <Style x:Key="AppTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Input Control Styles -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="FontSize" Value="{StaticResource AppInputFontSize}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <!-- Button Styles -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style x:Key="AppAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource AppContentFontSize}" />
    </Style>

    <Style x:Key="BorderlessIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarLabelButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
