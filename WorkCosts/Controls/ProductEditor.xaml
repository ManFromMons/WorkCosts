<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WorkCosts.Controls.ProductEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="0,0,8,20">
        <StackPanel Spacing="16" Padding="0,0,0,8">
            <!-- Parent: fields captured from the product page -->
            <StackPanel x:Name="PageFieldsPanel" Spacing="12">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.RowSpan="2" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Product image" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="118"
                                Height="118"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                            </Border>
                            <Grid
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Width="36"
                                Height="118">
                                <StackPanel VerticalAlignment="Top" Spacing="2">
                                    <Grid Width="36" Height="36">
                                        <Button
                                            x:Name="FetchImagesButton"
                                            Click="FetchImages_Click"
                                            Style="{ThemeResource BorderlessIconButtonStyle}"
                                            ToolTipService.ToolTip="Load images from product URL">
                                            <FontIcon x:Name="FetchImagesIcon" FontSize="16" Glyph="&#xE8B9;" />
                                        </Button>
                                        <ProgressRing
                                            x:Name="FetchImagesRing"
                                            Width="20"
                                            Height="20"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Button
                                        Click="ClearImage_Click"
                                        Style="{ThemeResource BorderlessIconButtonStyle}"
                                        ToolTipService.ToolTip="Clear image">
                                        <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                                <Button
                                    x:Name="OpenUrlButton"
                                    VerticalAlignment="Bottom"
                                    Click="OpenUrl_Click"
                                    IsEnabled="False"
                                    Style="{ThemeResource BorderlessIconButtonStyle}"
                                    ToolTipService.ToolTip="Open product page">
                                    <FontIcon FontSize="16" Glyph="&#xE774;" />
                                </Button>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Button
                            x:Name="ImportNewButton"
                            HorizontalAlignment="Left"
                            Click="ImportNew_Click"
                            Content="Load from new URL..."
                            Style="{StaticResource SubtleButtonStyle}" />
                        <Grid
                            x:Name="UrlEditPanel"
                            ColumnSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="UrlBox"
                                PlaceholderText="https://..."
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="UrlGoButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="UrlGo_Click"
                                Style="{ThemeResource BorderlessIconButtonStyle}"
                                ToolTipService.ToolTip="Load URL">
                                <FontIcon FontSize="16" Glyph="&#xE72A;" />
                            </Button>
                            <Button
                                x:Name="UrlCancelButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="UrlCancel_Click"
                                Style="{ThemeResource BorderlessIconButtonStyle}"
                                ToolTipService.ToolTip="Cancel import">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NameBox"
                            Header="Name"
                            PlaceholderText="Product name"
                            TextChanged="Field_Changed" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Style="{ThemeResource AppTextBlockStyle}" Text="Vendor" />
                            <TextBlock
                                x:Name="VendorBreadcrumb"
                                Style="{ThemeResource AppTextBlockStyle}"
                                Text="—"
                                TextWrapping="WrapWholeWords" />
                            <TextBox
                                x:Name="VendorBox"
                                PlaceholderText="Vendor"
                                TextChanged="Field_Changed"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="Auto" MinWidth="50" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ManufacturerBox"
                        MinWidth="50"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Manufacturer"
                        TextChanged="Field_Changed" />
                    <TextBox
                        x:Name="MfrBox"
                        Grid.Column="1"
                        MinWidth="50"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Manufacturer reference"
                        TextChanged="Field_Changed" />
                    <NumberBox
                        x:Name="CostBox"
                        Grid.Column="2"
                        MinWidth="50"
                        Width="88"
                        HorizontalAlignment="Left"
                        PlaceholderText="Unit cost"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="CostBox_ValueChanged" />
                </Grid>
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="*" MinWidth="50" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="EanBox"
                        MinWidth="50"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="EAN / GTIN"
                        TextChanged="Field_Changed" />
                    <TextBox
                        x:Name="VariationBox"
                        Grid.Column="1"
                        MinWidth="50"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Variation"
                        TextChanged="Field_Changed" />
                </Grid>
                <TextBox
                    x:Name="OemBox"
                    PlaceholderText="OEM equivalent"
                    TextWrapping="Wrap"
                    TextChanged="Field_Changed" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="*" MinWidth="50" />
                        <ColumnDefinition Width="*" MinWidth="50" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <NumberBox
                        x:Name="CapacityBox"
                        PlaceholderText="Capacity (Ah)"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="ExtraNumber_ValueChanged" />
                    <NumberBox
                        x:Name="CcaBox"
                        Grid.Column="1"
                        PlaceholderText="CCA"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="ExtraNumber_ValueChanged" />
                    <ComboBox
                        x:Name="TechnologyBox"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Technology"
                        SelectionChanged="TechnologyBox_SelectionChanged" />
                    <NumberBox
                        x:Name="LengthBox"
                        Grid.Row="1"
                        PlaceholderText="Length (mm)"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="ExtraNumber_ValueChanged" />
                    <NumberBox
                        x:Name="WidthBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        PlaceholderText="Width (mm)"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="ExtraNumber_ValueChanged" />
                    <NumberBox
                        x:Name="HeightBox"
                        Grid.Row="1"
                        Grid.Column="2"
                        PlaceholderText="Height (mm)"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="ExtraNumber_ValueChanged" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{ThemeResource AppTextBlockStyle}"
                        Text="Equivalent products"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Click="ManageEquivalents_Click"
                        Style="{ThemeResource BorderlessIconButtonStyle}"
                        ToolTipService.ToolTip="Choose equivalent products">
                        <FontIcon FontSize="16" Glyph="&#xE71B;" />
                    </Button>
                </Grid>
                <ItemsControl x:Name="EquivalentProductsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,0,0,4"
                                Opacity="0.85"
                                Style="{ThemeResource AppTextBlockStyle}"
                                Text="{Binding Path=DisplayText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Assignment: not filled from the page -->
            <RadioButtons
                x:Name="CategoryRadios"
                Header="Usage category"
                MaxColumns="6"
                SelectionChanged="CategoryRadios_SelectionChanged">
                <RadioButtons.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Path=Name}"
                            ToolTipService.ToolTip="{Binding Path=Name, Converter={StaticResource PromptValue}, ConverterParameter=Usage category}" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>
            <RadioButtons
                x:Name="PricePointRadios"
                Header="Price point"
                MaxColumns="3"
                SelectionChanged="PricePointRadios_SelectionChanged">
                <RadioButtons.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding Path=Label}"
                            ToolTipService.ToolTip="{Binding Path=Label, Converter={StaticResource PromptValue}, ConverterParameter=Price point}" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>
            <ToggleSwitch
                x:Name="AllJobsToggle"
                HorizontalAlignment="Left"
                OffContent="!All jobs"
                OnContent="All Jobs"
                Toggled="AllJobsToggle_Toggled" />
            <TextBlock FontWeight="SemiBold" Text="Assign to specific jobs" />
            <ItemsControl x:Name="JobChecks" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid
                            Orientation="Horizontal"
                            HorizontalChildrenAlignment="Left"
                            VerticalChildrenAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Margin="0,0,12,8"
                            Content="{Binding Path=Name}"
                            IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding Path=IsEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding Path=ToolTipText}"
                            Checked="JobCheck_Changed"
                            Unchecked="JobCheck_Changed" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Name="NoJobsText"
                Opacity="0.7"
                Text="No jobs defined yet."
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
