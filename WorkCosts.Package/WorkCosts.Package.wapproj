<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <_DesktopBridgeProps>$(WapProjPath)Microsoft.DesktopBridge.props</_DesktopBridgeProps>
    <_DesktopBridgeTargets>$(WapProjPath)Microsoft.DesktopBridge.targets</_DesktopBridgeTargets>
    <DesktopBridgeAvailable Condition="Exists('$(_DesktopBridgeProps)')">true</DesktopBridgeAvailable>
    <DesktopBridgeAvailable Condition="'$(DesktopBridgeAvailable)'==''">false</DesktopBridgeAvailable>
  </PropertyGroup>
  <Import Project="$(_DesktopBridgeProps)" Condition="'$(DesktopBridgeAvailable)'=='true'" />
  <PropertyGroup>
    <ProjectGuid>7C4E9B21-8A56-4F3D-9E10-B6D2C8A4F517</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <NoWarn>$(NoWarn);NU1503;NU1702</NoWarn>
    <EntryPointProjectUniqueName>..\WorkCosts\WorkCosts.csproj</EntryPointProjectUniqueName>
    <AssetTargetFallback>net9.0-windows$(TargetPlatformVersion);$(AssetTargetFallback)</AssetTargetFallback>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\WorkCosts\Assets\SplashScreen.scale-200.png">
      <Link>Images\SplashScreen.scale-200.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\LockScreenLogo.scale-200.png">
      <Link>Images\LockScreenLogo.scale-200.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\Square150x150Logo.scale-200.png">
      <Link>Images\Square150x150Logo.scale-200.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\Square44x44Logo.scale-200.png">
      <Link>Images\Square44x44Logo.scale-200.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\Square44x44Logo.targetsize-24_altform-unplated.png">
      <Link>Images\Square44x44Logo.targetsize-24_altform-unplated.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png">
      <Link>Images\Square44x44Logo.targetsize-48_altform-lightunplated.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\StoreLogo.png">
      <Link>Images\StoreLogo.png</Link>
    </Content>
    <Content Include="..\WorkCosts\Assets\Wide310x150Logo.scale-200.png">
      <Link>Images\Wide310x150Logo.scale-200.png</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(_DesktopBridgeTargets)" Condition="'$(DesktopBridgeAvailable)'=='true'" />
  <ItemGroup Condition="'$(DesktopBridgeAvailable)'=='true'">
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526">
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0">
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkCosts\WorkCosts.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\win-$(Platform).pubxml</PublishProfile>
    </ProjectReference>
  </ItemGroup>
  <!-- Keep `dotnet build WorkCosts.slnx` working when Visual Studio Desktop Bridge is not installed. -->
  <Target Name="Restore" Condition="'$(DesktopBridgeAvailable)'!='true'" />
  <Target Name="Build" Condition="'$(DesktopBridgeAvailable)'!='true'">
    <Message Importance="high" Text="WorkCosts.Package: Visual Studio Windows Application Packaging tools were not found. Daily F5 still uses the unpackaged WorkCosts project. To build an MSIX from the command line, run WorkCosts.Package\Pack-Msix.ps1." />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Build" Condition="'$(DesktopBridgeAvailable)'!='true'" />
  <Target Name="Clean" Condition="'$(DesktopBridgeAvailable)'!='true'" />
</Project>
