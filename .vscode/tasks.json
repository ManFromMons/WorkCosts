{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/WorkCosts.slnx",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-tests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/WorkCosts.Tests/WorkCosts.Tests.csproj",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/WorkCosts.slnx",
        "--settings",
        "${workspaceFolder}/.runsettings",
        "--nologo"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack-msix",
      "type": "shell",
      "command": "powershell -File WorkCosts.Package/Pack-Msix.ps1 -Runtime x64 -Version 1.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "merge-planning",
      "type": "shell",
      "command": "powershell -File scripts/Merge-PlanningToMain.ps1 -Message '${input:planningSquashMessage}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "update-to-review",
      "type": "shell",
      "command": "powershell -File scripts/Update-ToReviewOnMain.ps1 -Message '${input:toReviewMessage}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "planningSquashMessage",
      "type": "promptString",
      "description": "Squash commit message for Planning (used when more than one commit)",
      "default": "Apply Planning branch."
    },
    {
      "id": "toReviewMessage",
      "type": "promptString",
      "description": "Commit message for docs/features/to-review.md on main",
      "default": "Update docs/features/to-review.md."
    }
  ]
}
